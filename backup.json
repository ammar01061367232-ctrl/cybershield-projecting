{"version":24,"notes":[{"title":"<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>CyberShield Academy | School Project</title>\n    <!-- Importing Cairo font for clean modern look -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap\" rel=\"stylesheet\">\n    <style>\n        :root {\n            --bg-color: #0b132b;\n            --card-bg: #1c2541;\n            --accent-color: #4cc9f0;\n            --secondary-accent: #7209b7;\n            --text-color: #f8f9fa;\n            --text-muted: #adb5bd;\n            --success-color: #2ec4b6;\n            --danger-color: #e71d36;\n        }\n\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n            font-family: 'Cairo', sans-serif;\n        }\n\n        body {\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            line-height: 1.6;\n            padding: 20px;\n            direction: ltr;\n            text-align: left;\n        }\n\n        .container {\n            max-width: 900px;\n            margin: 0 auto;\n        }\n\n        header {\n            text-align: center;\n            padding: 40px 20px;\n            background: linear-gradient(135deg, #1c2541, #3a0ca3);\n            border-radius: 16px;\n            margin-bottom: 30px;\n            box-shadow: 0 10px 30px rgba(0,0,0,0.3);\n        }\n\n        header h1 {\n            font-size: 2.5rem;\n            color: var(--accent-color);\n            margin-bottom: 10px;\n        }\n\n        header p {\n            color: var(--text-muted);\n            font-size: 1.1rem;\n        }\n\n        .section {\n            background-color: var(--card-bg);\n            border-radius: 12px;\n            padding: 25px;\n            margin-bottom: 25px;\n            box-shadow: 0 5px 15px rgba(0,0,0,0.2);\n        }\n\n        .section h2 {\n            color: var(--accent-color);\n            margin-bottom: 15px;\n            font-size: 1.5rem;\n            border-bottom: 2px solid rgba(76, 201, 240, 0.2);\n            padding-bottom: 8px;\n        }\n\n        /* Password Strength Checker */\n        .password-tool input {\n            width: 100%;\n            padding: 12px;\n            border-radius: 8px;\n            border: 1px solid #48cae4;\n            background-color: #0b132b;\n            color: white;\n            font-size: 1rem;\n            margin-bottom: 10px;\n        }\n\n        .strength-meter {\n            height: 8px;\n            border-radius: 4px;\n            background-color: #2b2d42;\n            margin-bottom: 10px;\n            overflow: hidden;\n        }\n\n        .strength-fill {\n            height: 100%;\n            width: 0%;\n            transition: width 0.3s ease, background-color 0.3s ease;\n        }\n\n        .btn {\n            background-color: var(--accent-color);\n            color: #0b132b;\n            border: none;\n            padding: 10px 20px;\n            border-radius: 8px;\n            font-weight: 700;\n            cursor: pointer;\n            transition: opacity 0.2s;\n        }\n\n        .btn:hover {\n            opacity: 0.9;\n        }\n\n        /* Interactive Quiz */\n        .quiz-question {\n            margin-bottom: 15px;\n            font-weight: 600;\n        }\n\n        .quiz-options label {\n            display: block;\n            background-color: rgba(255,255,255,0.05);\n            padding: 10px 15px;\n            border-radius: 6px;\n            margin-bottom: 8px;\n            cursor: pointer;\n            transition: background 0.2s;\n        }\n\n        .quiz-options label:hover {\n            background-color: rgba(76, 201, 240, 0.1);\n        }\n\n        .quiz-options input {\n            margin-right: 10px;\n        }\n\n        /* Team Section */\n        .team-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n            gap: 15px;\n            margin-top: 15px;\n        }\n\n        .team-card {\n            background-color: rgba(11, 19, 43, 0.6);\n            border: 1px solid rgba(76, 201, 240, 0.2);\n            padding: 15px;\n            border-radius: 8px;\n            text-align: center;\n        }\n\n        .team-card h3 {\n            color: var(--accent-color);\n            margin-bottom: 5px;\n        }\n\n        .team-card p {\n            color: var(--text-muted);\n            font-size: 0.9rem;\n        }\n\n        footer {\n            text-align: center;\n            padding: 20px;\n            color: var(--text-muted);\n            font-size: 0.9rem;\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"container\">\n        <!-- Header -->\n        <header>\n            <h1>CyberShield Academy</h1>\n            <p>Integrated School Project for Cybersecurity Awareness & Data Protection</p>\n        </header>\n\n        <!-- Password Strength Tool -->\n        <section class=\"section password-tool\">\n            <h2>🔐 Password Strength Checker</h2>\n            <p style=\"margin-bottom: 12px; color: var(--text-muted);\">Test your password strength against potential cyber attacks:</p>\n            <input type=\"password\" id=\"pwdInput\" placeholder=\"Type your password here...\" oninput=\"checkPassword()\">\n            <div class=\"strength-meter\">\n                <div id=\"strengthFill\" class=\"strength-fill\"></div>\n            </div>\n            <p id=\"pwdFeedback\" style=\"font-size: 0.9rem; margin-bottom: 15px;\">Enter a password to verify...</p>\n            <button class=\"btn\" onclick=\"generateStrongPassword()\">Generate Strong Secure Password</button>\n        </section>\n\n        <!-- Interactive Quiz -->\n        <section class=\"section\">\n            <h2>📊 Quick Security Awareness Quiz</h2>\n            <div class=\"quiz-question\">Q: You received a message claiming you won a prize and must click a link immediately. What should you do?</div>\n            <div class=\"quiz-options\">\n                <label><input type=\"radio\" name=\"q1\" value=\"wrong\"> Click the link right away to claim the prize</label>\n                <label><input type=\"radio\" name=\"q1\" value=\"correct\"> Ignore and delete the message as it is a Phishing attempt</label>\n                <label><input type=\"radio\" name=\"q1\" value=\"wrong\"> Reply with your credit card details to verify transfer</label>\n            </div>\n            <button class=\"btn\" style=\"margin-top: 15px;\" onclick=\"checkQuiz()\">Check Answer</button>\n            <p id=\"quizResult\" style=\"margin-top: 10px; font-weight: 700;\"></p>\n        </section>\n\n        <!-- Team Section -->\n        <section class=\"section\">\n            <h2>👥 School Project Team</h2>\n            <p style=\"margin-bottom: 15px; color: var(--text-muted);\">This project was developed by the collaborative effort of 2nd Secondary Grade students:</p>\n            <div class=\"team-grid\">\n                <div class=\"team-card\">\n                    <h3 id=\"member1Name\">Student 1</h3>\n                    <p>UI Developer & Lead Designer</p>\n                </div>\n                <div class=\"team-card\">\n                    <h3 id=\"member2Name\">Student 2</h3>\n                    <p>Research & Content Specialist</p>\n                </div>\n                <div class=\"team-card\">\n                    <h3 id=\"member3Name\">Student 3</h3>\n                    <p>Security Tester & Scenarios</p>\n                </div>\n                <div class=\"team-card\">\n                    <h3 id=\"member4Name\">Student 4</h3>\n                    <p>Interactive Quiz Developer</p>\n                </div>\n                <div class=\"team-card\">\n                    <h3 id=\"member5Name\">Student 5</h3>\n                    <p>Presentation & Docs Coordinator</p>\n                </div>\n                <div class=\"team-card\">\n                    <h3 id=\"member6Name\">Student 6</h3>\n                    <p>Documentation & Reports Lead</p>\n                </div>\n            </div>\n            <button class=\"btn\" style=\"margin-top: 20px;\" onclick=\"editTeamNames()\">✏️ Edit Team Names</button>\n        </section>\n\n        <footer>\n            All Rights Reserved © CyberShield Project 2026 - 2nd Secondary\n        </footer>\n    </div>\n\n    <script>\n        // Password Checker Logic\n        function checkPassword() {\n            const pwd = document.getElementById('pwdInput').value;\n            const fill = document.getElementById('strengthFill');\n            const feedback = document.getElementById('pwdFeedback');\n            let strength = 0;\n\n            if (pwd.length >= 8) strength += 25;\n            if (/[A-Z]/.test(pwd)) strength += 25;\n            if (/[0-9]/.test(pwd)) strength += 25;\n            if (/[^A-Za-z0-9]/.test(pwd)) strength += 25;\n\n            fill.style.width = strength + '%';\n            if (strength <= 25) {\n                fill.style.backgroundColor = 'var(--danger-color)';\n                feedback.textContent = 'Very Weak - Highly vulnerable to hacking';\n                feedback.style.color = 'var(--danger-color)';\n            } else if (strength <= 75) {\n                fill.style.backgroundColor = '#fca311';\n                feedback.textContent = 'Moderate - Consider adding symbols, numbers, and uppercase letters';\n                feedback.style.color = '#fca311';\n            } else {\n                fill.style.backgroundColor = 'var(--success-color)';\n                feedback.textContent = 'Strong and completely secure!';\n                feedback.style.color = 'var(--success-color)';\n            }\n        }\n\n        // Password Generator\n        function generateStrongPassword() {\n            const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&*!\";\n            let pwd = \"\";\n            for (let i = 0; i < 12; i++) {\n                pwd += chars.charAt(Math.floor(Math.random() * chars.length));\n            }\n            document.getElementById('pwdInput').value = pwd;\n            checkPassword();\n        }\n\n        // Quiz Checker\n        function checkQuiz() {\n            const options = document.getElementsByName('q1');\n            let selected = \"\";\n            for (let opt of options) {\n                if (opt.checked) selected = opt.value;\n            }\n            const res = document.getElementById('quizResult');\n            if (selected === \"correct\") {\n                res.textContent = \"Correct answer! Excellent, this is a phishing scam.\";\n                res.style.color = \"var(--success-color)\";\n            } else if (selected === \"wrong\") {\n                res.textContent = \"Incorrect answer! Be careful, clicking this link steals data.\";\n                res.style.color = \"var(--danger-color)\";\n            } else {\n                res.textContent = \"Please select an answer first.\";\n                res.style.color = \"#fca311\";\n            }\n        }\n\n        // Edit Team Names\n        function editTeamNames() {\n            for (let i = 1; i <= 6; i++) {\n                const currentName = document.getElementById(`member${i}Name`).textContent;\n                const newName = prompt(`Enter name for Student ${i}:`, currentName);\n                if (newName !== null && newName.trim() !== \"\") {\n                    document.getElementById(`member${i}Name`).textContent = newName.trim();\n                    localStorage.setItem(`en_member_${i}`, newName.trim());\n                }\n            }\n            alert('Team names saved successfully!');\n        }\n\n        // Load saved names if any\n        window.onload = function() {\n            for (let i = 1; i <= 6; i++) {\n                const saved = localStorage.getItem(`en_member_${i}`);\n                if (saved) {\n                    document.getElementById(`member${i}Name`).textContent = saved;\n                }\n            }\n        }\n    </script>\n</body>\n</html>","creationDate":1794914115,"modifiedDate":1794914233,"color":"Pink","id":1}]}